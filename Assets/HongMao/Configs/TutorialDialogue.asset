  m_Script: {fileID: 11500000, guid: 2db7c3a57dd5744f1831ebb04c9d9998, type: 3}
  m_Name: TutorialDialogue
  m_EditorClassIdentifier: HongMao.Runtime::HongMao.DialogueDefinition
  speakerName: "\u5F15\u8DEF\u4EBA"
  lines:
  - "\u4F60\u597D\uFF0C\u6B22\u8FCE\u6765\u5230\u9E3F\u6BDB\u7684\u7EC3\u4E60\u573A\uFF01\u6211\u662F\u8FD9\u91CC\u7684\u5F15\u8DEF\u4EBA\u3002\u5148\u5728\u9AD8\u53F0\u4E0A\u6B47\u4E00\u6B47\uFF0C\u6211\u6765\u966A\u4F60\u719F\u6089\u6218\u6597\u3002\u6309
    E \u7EE7\u7EED\uFF0C\u968F\u65F6\u6309 Esc \u79BB\u5F00\uFF1B\u60F3\u590D\u4E60\u65F6\u518D\u6765\u627E\u6211\u3002"
  - "\u5148\u6D3B\u52A8\u4E00\u4E0B\uFF1AA / D \u5DE6\u53F3\u79FB\u52A8\uFF0CSpace
    \u8DF3\u8DC3\u3002\u5DE6\u952E\u653B\u51FB\uFF0C\u5730\u9762\u53EF\u8FDE\u7EED\u6253\u51FA\u4E09\u6BB5\uFF0C\u8DF3\u8D77\u540E\u4E5F\u80FD\u653B\u51FB\u3002\u6CBF\u4E24\u4FA7\u53F0\u9636\u9010\u7EA7\u8DF3\u8DC3\uFF0C\u5C31\u80FD\u5230\u8FBE\u9AD8\u5904\u3002"
  - "\u654C\u4EBA\u51FA\u62DB\u65F6\uFF0C\u53F3\u952E\u62DB\u67B6\u3002\u6210\u529F\u62DB\u67B6\u83B7\u5F97
    2 \u683C\u5145\u80FD\u3002\u770B\u5230\u6A59\u8272\u653B\u51FB\u9884\u8B66\u8981\u7528
    Shift \u95EA\u907F\uFF1B\u53EA\u6709\u5728\u65E0\u654C\u65F6\u95F4\u5185\u771F\u6B63\u8EB2\u8FC7\u547D\u4E2D\uFF0C\u624D\u4F1A\u83B7\u5F97
    1 \u683C\u5145\u80FD\uFF0C\u539F\u5730\u7A7A\u95EA\u4E0D\u7B97\u3002"
  - "\u5145\u80FD\u4E0A\u9650\u662F 3 \u683C\u3002\u6EE1\u5145\u80FD\u4E14\u8FD8\u6709\u7A7A\u7EA2\u69FD\u65F6\uFF0C\u6309
    Q \u8FDB\u5165\u6162\u52A8\u4F5C\u5438\u8272\uFF1A\u9F20\u6807\u6307\u5411\u7EA2\u8272\u67F1\u4F53\uFF0C\u5DE6\u952E\u786E\u8BA4\u3002\u53F3\u952E\u3001Q
    \u6216 Esc \u53EF\u53D6\u6D88\uFF0C\u53D6\u6D88\u4E0D\u6D88\u8017\u8D44\u6E90\u3002"
  - "\u6210\u529F\u5438\u8272\u4F1A\u6E05\u7A7A\u5145\u80FD\u3001\u586B\u5165 1 \u4E2A\u7EA2\u69FD\uFF0C\u5E76\u83B7\u5F97\u4E00\u6B21\u5F3A\u5316\u653B\u51FB\u3002\u88AB\u5438\u53D6\u7684\u7EA2\u8272\u6E90\u4F1A\u53D8\u7070\uFF0C3
    \u79D2\u540E\u6062\u590D\uFF1B\u53EF\u4EE5\u518D\u6B21\u5229\u7528\u5B83\u7EC3\u4E60\u3002"
  - "\u6709\u5F3A\u5316\u653B\u51FB\u65F6\uFF1A\u4E0D\u6309\u4E0A\u4E0B\u65B9\u5411\uFF0C\u5DE6\u952E\u4F7F\u51FA\u7A81\u8FDB\u65A9\uFF1BW
    + \u5DE6\u952E\u4E0A\u6311\uFF1B\u7A7A\u4E2D S + \u5DE6\u952E\u4E0B\u7838\u3002\u5730\u9762
    S + \u5DE6\u952E\u4ECD\u662F\u666E\u901A\u653B\u51FB\uFF0C\u4F1A\u4FDD\u7559\u5F3A\u5316\u673A\u4F1A\u3002\u5F3A\u5316\u653B\u51FB\u4E0D\u6D88\u8017\u5DF2\u586B\u5165\u7684\u7EA2\u69FD\u3002"
  - "\u654C\u4EBA\u6709\u751F\u547D\u548C\u9738\u4F53\u4E24\u6761\u72B6\u6001\u3002\u653B\u51FB\u524A\u51CF\u9738\u4F53\uFF1B\u7834\u9738\u4F53\u540E\uFF0C\u5F3A\u5316\u4E0A\u6311\u5C31\u80FD\u628A\u654C\u4EBA\u6311\u7A7A\uFF0C\u518D\u63A5\u7A7A\u4E2D\u653B\u51FB\u3002\u53EF\u4EE5\u4ECE\u4E0B\u65B9\u7684\u8BAD\u7EC3\u5BF9\u624B\u5F00\u59CB\u7EC3\u4E60\u3002"
  - "\u6512\u6EE1 3 \u4E2A\u7EA2\u69FD\u540E\uFF0C\u6309 R \u6FC0\u6D3B\u7EA2\u8138\u8C31\uFF0C\u6301\u7EED
    8 \u79D2\uFF0C\u653B\u51FB\u66F4\u5FEB\u3001\u7834\u9738\u4F53\u80FD\u529B\u66F4\u5F3A\u3002\u5F00\u542F\u4F1A\u6E05\u7A7A\u7EA2\u69FD\u548C\u5269\u4F59\u5F3A\u5316\u673A\u4F1A\uFF1B\u671F\u95F4\u4E0D\u80FD\u518D\u79EF\u7D2F\u5145\u80FD\u6216\u5438\u8272\u3002"
  - "\u8BB0\u4F4F\u8FD9\u4E2A\u5FAA\u73AF\uFF1A\u62DB\u67B6\u6216\u95EA\u907F \u2192
    \u6EE1\u5145\u80FD\u5438\u8272 \u2192 \u4F7F\u7528\u5F3A\u5316\u653B\u51FB \u2192
    \u4E09\u7EA2\u69FD\u5F00\u542F\u8138\u8C31\u3002\u80DC\u5229\u6216\u5931\u8D25\u540E\u6309
    Enter \u91CD\u5F00\u3002\u51C6\u5907\u597D\u4E86\u5C31\u56DE\u5730\u9762\u8BD5\u8BD5\u5427\uFF01\u4E4B\u540E\u60F3\u590D\u4E60\uFF0C\u968F\u65F6\u6765\u627E\u6211\u3002"
